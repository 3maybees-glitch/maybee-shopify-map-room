<header class="site-header">
  <div class="wrap header-row">
    <a class="brand" href="{{ routes.root_url }}">
      {% if settings.logo != blank %}
        <img src="{{ settings.logo | image_url: width: 120 }}" alt="{{ shop.name }}">
      {% else %}
        <img src="https://www.maybeecreations.com/maybee-creations-logo.png" alt="{{ shop.name }}">
      {% endif %}
      <span class="brand-text">
        <strong>{{ shop.name | upcase }}</strong>
        <span>The Map Room</span>
      </span>
    </a>
    <div class="header-actions">
      <a class="studio-link" href="https://www.maybeecreations.com" target="_blank" rel="noreferrer">Studio</a>
      <a class="icon-btn" href="{{ routes.search_url }}" aria-label="Search maps">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      </a>
      <a class="icon-btn" href="{{ routes.cart_url }}" aria-label="Expedition pack">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M6 7h15l-1.4 8.2a2 2 0 0 1-2 1.8H9.2a2 2 0 0 1-2-1.6L5 4H3"/><circle cx="10" cy="20" r="1.3"/><circle cx="18" cy="20" r="1.3"/></svg>
        <span class="cart-count{% if cart.item_count > 0 %} show{% endif %}">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
  <nav class="compass" aria-label="Shop by world">
    <div class="wrap compass-row">
      <a class="world-tab" data-world="all" href="/collections/all"><small>The shop</small><b>ALL MAPS</b></a>
      {% assign worlds = 'faith,freedom,frontier,fans,future' | split: ',' %}
      {% assign kickers = 'Soul Explorer,Liberty Explorer,Discovery Explorer,Legend Explorer,Tomorrow Explorer' | split: ',' %}
      {% for handle in worlds %}
        <a class="world-tab{% if collection.handle == handle %} active{% endif %}" data-world="{{ handle }}" href="/collections/{{ handle }}">
          <small>{{ kickers[forloop.index0] }}</small>
          <b>{{ handle | upcase }}</b>
        </a>
      {% endfor %}
    </div>
  </nav>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
